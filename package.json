{
  "name": "storybook-addon-flow-direction",
  "version": "0.3.0",
  "description": "Stress-test writing-mode and direction in Storybook and detect physical CSS with logical-property hints.",
  "keywords": [
    "storybook-addon",
    "storybook-addons",
    "i18n",
    "rtl",
    "writing-mode",
    "logical-properties"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brechtDR/storybook-addon-flow-direction.git"
  },
  "bugs": {
    "url": "https://github.com/brechtDR/storybook-addon-flow-direction/issues"
  },
  "homepage": "https://github.com/brechtDR/storybook-addon-flow-direction#readme",
  "license": "MIT",
  "author": "Brecht De Ruyte",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./preset": "./dist/preset.js",
    "./manager": "./dist/manager.js",
    "./manager-helpers": "./dist/manager-helpers.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "manager.js",
    "preview.js",
    "preset.js",
    "assets/icon.svg"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "build": "run-s build:manager build:preview build:node",
    "build:manager": "tsup src/manager.tsx src/manager-helpers.tsx --no-config --format esm --platform browser --target esnext --external react --external react-dom --external @storybook/icons --out-dir dist",
    "build:preview": "tsup src/preview.ts src/index.ts --no-config --format esm --platform browser --target esnext --external react --external react-dom --external @storybook/icons --out-dir dist --dts",
    "build:node": "tsup src/preset.ts --no-config --format esm --platform node --target node20.19 --out-dir dist",
    "build-storybook": "storybook build",
    "build:watch": "run-p build:manager:watch build:preview:watch build:node:watch",
    "build:manager:watch": "pnpm run build:manager -- --watch",
    "build:preview:watch": "pnpm run build:preview -- --watch",
    "build:node:watch": "pnpm run build:node -- --watch",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build && zx scripts/prepublish-checks.js",
    "start": "run-p build:watch \"storybook --quiet\"",
    "storybook": "storybook dev -p 6006",
    "test": "pnpm run test:unit",
    "test:unit": "tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@storybook/addon-docs": "next",
    "@storybook/icons": "^2.0.0",
    "@storybook/react-vite": "next",
    "@types/node": "^20",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.7.0",
    "boxen": "^8.0.1",
    "clsx": "^2.1.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "next",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "prompts": "^2.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "next",
    "ts-dedent": "^2.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.1",
    "tsx": "^4.20.6",
    "vite": "^7.0.5",
    "zx": "^8.7.1"
  },
  "peerDependencies": {
    "storybook": "^10.0.0",
    "@storybook/icons": "^2.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "managerEntries": [
      "src/manager.tsx",
      "src/manager-helpers.tsx"
    ],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ],
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "storybook": {
    "displayName": "Flow Direction",
    "supportedFrameworks": [
      "react",
      "vue3",
      "angular",
      "web-components",
      "html",
      "svelte",
      "preact"
    ],
    "unsupportedFrameworks": [],
    "icon": "https://raw.githubusercontent.com/brechtDR/storybook-addon-flow-direction/main/assets/icon.svg"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
